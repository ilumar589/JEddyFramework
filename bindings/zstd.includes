# Curated jextract include list for zstd 1.5.7 (DESIGN §6.4): the stable API used by the
# compress module and the cooker (one-shot, streaming, dictionaries, training). No deprecated
# stream API, no experimental parameters, no opaque context structs.

# zdict.h
--include-function ZDICT_finalizeDictionary
